# LEAVE THIS UNSET. The Bingers session now comes from the /setup page and is
# stored in the database, so it survives restarts and can be replaced without
# editing this file. Set it only to seed a session you already captured by hand,
# into a database that has none: a cookie persisted by /setup wins over this
# value, so it cannot be used to replace a session that is already stored. To
# replace one, use /setup -- it reopens by itself once the stored session stops
# working.
# BINGERS_SESSION_COOKIE=
PLEX_URL=http://<plex-host-ip>:32400
PLEX_TOKEN=
ALLOWED_USER=
DRY_RUN=true
PORT=8787
# LEAVE THIS UNSET when running via docker compose -- the compose default
# (/data/bingers-sync.db) points inside the bind mount. A relative path here
# resolves inside the container's /app and the outbox dies with the container.
# Set it only for a bare-metal run, e.g. DB_PATH=./data/bingers-sync.db
# DB_PATH=/data/bingers-sync.db
# NOTE: use the IP, not a hostname — "plex.local" has no DNS record on the LAN.
# How long a title's cached versions.json is trusted without re-checking.
# An episode that MISSES the cache always re-checks versions.json regardless of
# this value (a newly aired episode cannot wait out the TTL); this governs the
# proactive re-check for a title whose episodes all resolve from cache. Either
# way, only seasons whose hash actually changed are re-downloaded.
CATALOG_TTL_HOURS=24
SEARCH_MAX_PAGES=3
SYNC_PULL_INTERVAL_MIN=30
WATCH_DATE_TOLERANCE_SEC=120
# Minimum gap between /allLeaves backfill scans for the SAME plex show. Inside
# this window a scrobble still writes its own episode; only the backfill scan is
# suppressed. A show that is fully reconciled (everything plex reports watched is
# already watched on bingers) is skipped regardless of this value, so the steady
# state for a show you watch weekly is no extra plex calls at all.
PLEX_ALLLEAVES_TTL_MIN=60
NOTIFY_URL=
