BINGERS_SESSION_COOKIE=
PLEX_URL=http://plex.local:32400
PLEX_TOKEN=
ALLOWED_USER=plexuser
DRY_RUN=true
PORT=8787
DB_PATH=/data/bingers-sync.db
# NOT YET IMPLEMENTED — parsed and exposed on the config object, but nothing
# reads it yet: catalog entries are re-fetched on a miss, never on age.
# Changing it has no effect. Catalog TTL caching is a follow-up task.
CATALOG_TTL_HOURS=24
SEARCH_MAX_PAGES=3
SYNC_PULL_INTERVAL_MIN=30
WATCH_DATE_TOLERANCE_SEC=120
# NOT YET IMPLEMENTED — parsed and exposed on the config object, but allLeaves
# is currently fetched on every episode scrobble that runs backfill.
# Changing it has no effect. allLeaves caching is a follow-up task.
PLEX_ALLLEAVES_TTL_MIN=60
NOTIFY_URL=
